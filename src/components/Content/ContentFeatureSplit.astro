---
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Img from "@/components/Media/Img.astro";

type HeadingTag = "h2" | "h3" | "h4" | "h5" | "h6";

interface Props {
  /** The block's title. Inline markup is rendered. */
  title: string;
  /** Body copy under the title. Inline markup is rendered. */
  text: string;
  /** An imported asset, a remote `http(s)` URL, or a path to a file in `public/`. */
  image: ImageMetadata | string;
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Leave unset on decorative images — renders `alt=""`. */
  imageAlt?: string;
  /** Heading level, for the page outline. Every title is the same size. */
  headingTag?: HeadingTag;
}

const {
  render = true,
  title,
  text,
  image,
  imageAlt,
  headingTag = "h3",
} = Astro.props;
---

{
  render && (title || image) && (
    <div class="feature-split_wrap">
      <div class="feature-split_content">
        <Heading tag={headingTag} variant="h5">
          <Fragment set:html={title} />
        </Heading>
        <Paragraph maxWidth={41}>
          <Fragment set:html={text} />
        </Paragraph>
      </div>
      <Img class="feature-split_visual" src={image} alt={imageAlt} />
    </div>
  )
}

<style is:global>
  @layer components {
    .feature-split_wrap {
      width: 100%;
      display: grid;
      gap: var(--space-5) var(--site-gutter);
      align-items: end;
      @media (width >= 64rem) {
        grid-template-columns: 50% minmax(0, 1fr);
      }
    }

    .feature-split_content {
      display: flex;
      flex-direction: column;
      justify-content: end;
      gap: var(--space-4);
      padding-bottom: var(--space-4);
      border-bottom: var(--border-width) solid var(--border);

      & > * {
        margin-block: 0;
      }
    }

    .feature-split_visual {
      width: 100%;
      aspect-ratio: 640 / 301;
      border-radius: var(--radius-main);
    }
  }
</style>
