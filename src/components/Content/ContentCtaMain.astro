---
import Heading from "@/components/Typography/Heading.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Img from "@/components/Media/Img.astro";
import cta from "@/assets/images/cta.jpg";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <div class="cta_wrap">
      <Img class="cta_visual" src={cta} />
      <div class="cta_content">
        <Heading tag="h2" variant="h1" maxWidth={24}>
          What would you like off your plate?
        </Heading>
        <ButtonWrapper marginTop="6">
          <Button element="link" href="#waitlist">
            Join waitlist
          </Button>
          <Button element="link" href="#demo" emphasis="secondary">
            Book a demo
          </Button>
        </ButtonWrapper>
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .cta_wrap {
      --_alignment: center;
      position: relative;
      width: 100%;
      min-height: 26rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-radius: var(--radius-main);
      overflow: clip;
    }

    .cta_visual {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .cta_content {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding-block: var(--section-space-medium);
      padding-inline: var(--space-5);

      & > * {
        margin-block: 0;
      }
    }
  }
</style>
