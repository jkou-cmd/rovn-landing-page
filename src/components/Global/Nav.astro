---
import Icon from "@/components/Media/Icon.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import mark from "@/assets/logo/rovn-mark.svg";
import wordmark from "@/assets/logo/rovn-wordmark.svg";
import { SITE_NAME } from "@/consts.ts";
import { withBase } from "@/utils/paths.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_haze" aria-hidden="true">
        <span />
        <span />
        <span />
        <span />
      </div>
      <div class="nav_inner">
        <a class="nav_logo" href={withBase("/")} aria-label={SITE_NAME}>
          <Icon class="nav_mark" src={mark} variant="full-width" />
          <Icon class="nav_wordmark" src={wordmark} variant="full-width" />
        </a>
        <ButtonWrapper class="nav_actions" marginTop="0">
          <Button element="link" href="#waitlist">
            Join waitlist
          </Button>
          <Button element="link" href="#demo" emphasis="secondary">
            Book a demo
          </Button>
        </ButtonWrapper>
      </div>
    </header>
  )
}

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      color: var(--text);

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    /*
      The bar has no fill of its own, only a blur that deepens towards the top.
      Each layer blurs a little more than the one under it and is masked to a
      shorter band, so the strength ramps rather than steps.
    */
    .nav_haze {
      position: absolute;
      inset: 0;
      pointer-events: none;

      & > span {
        position: absolute;
        inset: 0;
        backdrop-filter: blur(var(--_blur));
        -webkit-backdrop-filter: blur(var(--_blur));
        mask-image: linear-gradient(
          to bottom,
          black var(--_hold),
          transparent var(--_fade)
        );
      }

      & > span:nth-child(1) {
        --_blur: 1px;
        --_hold: 55%;
        --_fade: 100%;
      }
      & > span:nth-child(2) {
        --_blur: 2px;
        --_hold: 35%;
        --_fade: 80%;
      }
      & > span:nth-child(3) {
        --_blur: 4px;
        --_hold: 18%;
        --_fade: 58%;
      }
      & > span:nth-child(4) {
        --_blur: 8px;
        --_hold: 0%;
        --_fade: 36%;
      }
    }

    .nav_inner {
      position: relative;
      width: 100%;
      max-width: var(--max-width-main);
      min-height: var(--nav-height);
      padding-block: var(--space-2);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3) var(--space-6);
    }

    .nav_logo {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_logo .icon.nav_mark {
      width: auto;
      height: 1.5625rem;
    }

    .nav_logo .icon.nav_wordmark {
      width: auto;
      height: 1.4375rem;
    }
  }
</style>
